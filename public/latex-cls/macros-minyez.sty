% QC & DFT
\providecommand{\KS}{\mathrm{KS}}
\providecommand{\GKS}{\mathrm{GKS}}
\providecommand{\BZ}{\mathrm{BZ}}
\providecommand{\QP}{\mathrm{QP}}
\providecommand{\IP}{\mathrm{IP}}
