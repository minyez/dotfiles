% Solid states physics
\providecommand{\Nk}{N_{\bk}}
\providecommand{\invNk}{\frac{1}{\Nk}}
\providecommand{\invsqNk}{\frac{1}{\sqrt{\Nk}}}
\providecommand{\Nq}{N_{\bq}}
\providecommand{\invNq}{\frac{1}{\Nq}}
\providecommand{\invsqNq}{\frac{1}{\sqrt{\Nq}}}
\providecommand{\kg}[3]{$#1\times #2 \times #3$}
\providecommand{\kgh}[1]{\kg{#1}{#1}{#1}}

% operators
\providecommand{\argmin}{\mathop{\mathrm{argmin}}}
\providecommand{\argmax}{\mathop{\mathrm{argmax}}}
% text on operator using stackrel, such as \approx, =
\providecommand{\textonop}[2]{\ensuremath{\stackrel{\text{#1}}{#2}}}
\providecommand{\defeq}{\textonop{def}{=}}
\providecommand{\infint}{\int_{-\infty}^{\infty}}
\providecommand{\qsgn}{\text{sgn}}
\providecommand{\erfc}{\mathrm{erfc}}
\providecommand{\cMu}{\mathcal{U}} % emulate uppercase \mu
\providecommand{\cNu}{\mathcal{V}} % emulate uppercase \nu

% braces
\providecommand{\lara}[1]{\left\langle #1 \right\rangle}
\providecommand{\lbrb}[1]{\left\lbrace #1 \right\rbrace}
\providecommand{\pangle}[1]{\left\langle #1 \right\rangle}
\providecommand{\pbraket}[2]{\left(#1\middle|#2\right)}
\providecommand{\bbraket}[2]{\left[#1\middle|#2\right]}
\fi

% Code snippets
\iftogglecode
  \RequirePackage{listings}
  \definecolor{codebg}{RGB}{246,248,250}
  \definecolor{codeframe}{RGB}{210,215,220}
  \lstset{
    basicstyle=\ttfamily\small,
    backgroundcolor=\color{codebg},
    frame=single,
    rulecolor=\color{codeframe},
    columns=fullflexible,
    keepspaces=true,
    breaklines=true,
    showstringspaces=false
  }

  \RequirePackage[newfloat,cache=true]{minted}
  \definecolor{mycodebg}{rgb}{0.95,0.95,0.95}
  \setminted{linenos,mathescape,autogobble,breaklines,bgcolor=mycodebg}
  \setmintedinline{bgcolor=mycodebg}

  \RequirePackage{fancyvrb}
  \RequirePackage{fvextra}
  \definecolor{myshadecolor}{RGB}{99,99,99}
  \DefineVerbatimEnvironment{Highlighting}{Verbatim}{framesep=5pt,frame=single,%
    rulecolor=\color{myshadecolor},numbers=left,numbersep=10pt,commandchars=\\\{\}}
  \renewcommand{\theFancyVerbLine}{\small\arabic{FancyVerbLine}}
\fi

% use the journal abbreviation when biblatex is on
% see https://tex.stackexchange.com/questions/66549/short-titles-journal-abbreviations-etc-in-biblatex
\iftogglebib
\makeatletter
\ltx@ifpackageloaded{biblatex}%
{%
\DeclareFieldFormat{titlecase}{#1}% otherwise journal names are in sentence case with phys style
\renewbibmacro*{journal}{%
\ifboolexpr{ test {\ifcitation} and not test {\iffieldundef{shortjournal}} }
{\printfield[journaltitle]{shortjournal}}
{\iffieldundef{journaltitle}
{}
{\printtext[journaltitle]{%
\printfield[titlecase]{journaltitle}%
\setunit{\subtitlepunct}%
\printfield[titlecase]{journalsubtitle}}}}}
% add link to pages according to available fields
\newbibmacro{string+doiurlisbn}[1]{%
\iffieldundef{url}{%
\iffieldundef{doi}{%
\iffieldundef{isbn}{%
\iffieldundef{issn}{%
#1%
}{ \href{http://books.google.com/books?vid=ISSN\thefield{issn}}{#1} }%
}{ \href{http://books.google.com/books?vid=ISBN\thefield{isbn}}{#1} }%
}{ \href{https://dx.doi.org/\thefield{doi}}{#1} }%
}{ \href{\thefield{url}}{#1} }%
}
\DeclareFieldFormat[article,incollection]{pages}{\usebibmacro{string+doiurlisbn}{#1}}%
\DeclareFieldFormat[book]{title}{\usebibmacro{string+doiurlisbn}{\mkbibemph{#1}}}
% backref leading text
\DefineBibliographyStrings{english}{%
backrefpage  = {p.\addspace},
backrefpages = {pp.\addspace},
}
}
{}%
\makeatother
\fi
