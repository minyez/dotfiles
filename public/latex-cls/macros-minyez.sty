\providecommand{\dbG}{\hat{\bG}}
\providecommand{\dbr}{\hat{\br}}
\providecommand{\dbq}{\hat{\bq}}
\providecommand{\dbk}{\hat{\bk}}
\providecommand{\tran}{\mathsf{T}}
